{
    "name": "tigusigalpa/nansen-php",
    "description": "A framework-agnostic PHP client for the Nansen AI API with first-class Laravel support.",
    "type": "library",
    "keywords": [
        "nansen",
        "api",
        "client",
        "php",
        "laravel",
        "smart-money",
        "crypto",
        "blockchain"
    ],
    "homepage": "https://github.com/tigusigalpa/nansen-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Igor Sazonov",
            "email": "sovletig@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.4 || ^8.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Tigusigalpa\\Nansen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tigusigalpa\\Nansen\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tigusigalpa\\Nansen\\Laravel\\NansenServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
